{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run db:migrate:deploy && npm run build",
  "crons": [
    { "path": "/api/cron/abandoned-carts", "schedule": "0 * * * *" },
    { "path": "/api/cron/product-education", "schedule": "0 14 * * *" },
    { "path": "/api/cron/review-requests", "schedule": "0 15 * * *" },
    { "path": "/api/cron/reconcile-orders", "schedule": "15 * * * *" }
  ]
}
