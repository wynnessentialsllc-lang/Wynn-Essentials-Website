# Stripe API keys. Use sk_test_/pk_test_ values until live checkout is signed off.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=

STRIPE_TAX_ENABLED=false
STRIPE_PROMOTION_CODES_ENABLED=false

# Filled in automatically by `npm run stripe:setup`.
STRIPE_STANDARD_SHIPPING_RATE_ID=
STRIPE_EXPEDITED_SHIPPING_RATE_ID=
STRIPE_FREE_SHIPPING_RATE_ID=

# Neon Postgres (Vercel Marketplace) — orders database.
# Use the POOLED connection string. Server-only: never prefix with NEXT_PUBLIC_.
ORDERS_DATABASE_URL=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
