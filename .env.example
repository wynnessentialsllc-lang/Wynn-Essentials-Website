# Stripe API keys. Use sk_test_/pk_test_ values until live checkout is signed off.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Public (browser-safe) publishable key for the on-page "Pay in 4" messaging
# element on product pages. Same pk_ value as STRIPE_PUBLISHABLE_KEY, but it MUST
# carry the NEXT_PUBLIC_ prefix to be readable in the browser. If unset, the
# messaging simply does not render.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From `stripe listen` locally, or the endpoint's signing secret in the dashboard.
STRIPE_WEBHOOK_SECRET=

STRIPE_TAX_ENABLED=false
STRIPE_PROMOTION_CODES_ENABLED=false

# Filled in automatically by `npm run stripe:setup`.
STRIPE_STANDARD_SHIPPING_RATE_ID=
STRIPE_EXPEDITED_SHIPPING_RATE_ID=
STRIPE_FREE_SHIPPING_RATE_ID=

# Neon Postgres via the Vercel integration — orders database.
# Injected automatically in Vercel; locally run: npx vercel env pull .env.local
# Server-only. Never rename either of these with a NEXT_PUBLIC_ prefix.
ORDERS_DATABASE_POSTGRES_URL=
ORDERS_DATABASE_POSTGRES_URL_NON_POOLING=

# Gate for /admin/orders (fulfillment view). Random, 16+ chars, server-only.
# Generate one with: openssl rand -base64 32
ADMIN_ORDERS_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Owner email notifications via Resend (https://resend.com). Optional: if no key
# is set, order/review alerts are simply skipped (nothing breaks). Create a key
# in the Resend dashboard; it starts with "re_". RESEND_API_KEY is the standard
# name; wynnessentials_site is also accepted (first match wins).
RESEND_API_KEY=
# Where owner alerts are delivered. Defaults to wynnessentialsllc@gmail.com.
NOTIFY_TO=wynnessentialsllc@gmail.com
# From address. Keep the Resend onboarding sender until the sending domain is
# verified in Resend; then switch to your own, e.g.
# "Wynn Essentials <notifications@wynnessentialsllc.us>".
NOTIFY_FROM=Wynn Essentials <onboarding@resend.dev>

# Secret that authorizes the abandoned-cart cron (/api/cron/abandoned-carts).
# Set a random 16+ char value in Vercel; Vercel Cron sends it automatically as a
# Bearer token. Without it, the cron endpoint returns 503 (disabled).
CRON_SECRET=

# Secret used to sign one-click email unsubscribe links (CAN-SPAM). Optional:
# if unset, the app falls back to CRON_SECRET, then STRIPE_WEBHOOK_SECRET, so
# unsubscribe links keep working. Set a dedicated random value to be explicit.
UNSUBSCRIBE_SECRET=

# --- Shop by CrownPrint™ (Hair Wellness Lab integration) ---
# Hair Wellness Lab (HWL) stays the source of truth for the CrownPrint assessment
# and the Wynn Essentials Match. Wynn Essentials only retrieves a minimal,
# consumer-safe match. All of these are SERVER-ONLY (no NEXT_PUBLIC_ prefix) so
# the service credential is never exposed in the browser. If they are unset, the
# page shows an explicit "connecting soon" integration-unavailable state — it
# never fabricates match data. Supplying these activates the live integration
# with no UI changes.
#
# Server-to-server base URL + bearer token for the approved safe-match API.
HWL_API_BASE_URL=
HWL_SERVICE_TOKEN=
# Path on the HWL API that exchanges a handoff token for a safe match. The app
# POSTs { handoff } with the bearer token and expects the safe-match JSON back.
HWL_MATCH_PATH=/api/wynn-essentials-match
# Public HWL flows the shopper is redirected to. HWL should redirect back to
# <site>/shop-by-crownprint/connect with the handoff token and the echoed state.
HWL_ASSESSMENT_URL=
HWL_CROWNSTATE_UPDATE_URL=
# Optional: HWL Product Hub URL for the "no strong match" outcome. If unset, the
# guidance still shows but the button is omitted.
HWL_PRODUCT_HUB_URL=
# HMAC secret used to sign the short-lived, single-purpose httpOnly handoff
# cookie and the CSRF state. 16+ random chars (openssl rand -base64 32). Falls
# back to ADMIN_ORDERS_TOKEN.
CROWNPRINT_HANDOFF_SECRET=

# Ad-retargeting & analytics pixels (all optional). Each pixel loads only when
# its id is set here; leave blank to disable. These are browser-exposed by
# design (NEXT_PUBLIC_), which is expected for marketing pixels.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
